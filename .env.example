# Copy to .env and fill in values (never commit .env)

GITHUB_HOST=https://github.example.com
GITHUB_REPO=org/repo
GITHUB_PERSONAL_ACCESS_TOKEN=
# Branch for Contents API (ids-content uses main). Omit or set empty to use repo default branch.
GITHUB_REF=main
# Optional: exact repo folder under ids-content (usually under `content/...`) if defaults 404
GITHUB_COMPONENT_DOCS_PREFIX=

# Ollama: text / embeddings / vision (vision model required for design-spec image extraction)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=llava
LLM_MODEL=llama3

FIGMA_TOKEN=
# Optional default file key. Usually omit: each component supplies figmaUrl in data/component-figma-map.json.
FIGMA_FILE_KEY=
FIGMA_MCP_URL=

# Active design system: "ids" (default) or "synapse"
DESIGN_SYSTEM=ids
