{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "outDir": "./compiled",
    "declaration": false,
    "noEmit": false,
    "importHelpers": false,
    "paths": {
      "@storybook/angular": ["node_modules/@storybook/angular"],
      "@storybook/*": ["node_modules/@storybook/*"],
      "@component-contracts/*": ["../component-contracts/*"],
      "@angular/*": ["node_modules/@angular/*"]
    }
  },
  "include": [
    "src/components/ids-accordion/**/*.ts",
    "src/components/ids-alert/**/*.ts",
    "src/components/ids-icon/**/*.ts",
    "src/components/ids-button/ids-button.component.ts",
    "src/components/ids-button/ids-button.imports.ts",
    "src/components/ids-badge/ids-badge.component.ts",
    "src/components/ids-checkbox/**/*.ts",
    "src/components/ids-radio-button/**/*.ts",
    "src/components/ids-tab/**/*.ts",
    "src/components/ids-text-box/**/*.ts",
    "src/components/ids-modal/**/*.ts",
    "src/components/ids-masthead/**/*.ts",
    "src/components/ids-main-menu-left/**/*.ts",
    "src/components/ids-footer/**/*.ts",
    "src/components/ids-dropdown/**/*.ts",
    "src/components/ids-tag/**/*.ts",
    "src/components/ids-tooltip/**/*.ts",
    "src/components/ids-segmented-button/**/*.ts",
    "src/components/ids-datagrid/**/*.ts",
    "src/components/ids-pagination/**/*.ts",
    "src/components/ids-detail-panel/**/*.ts",
    "../component-contracts/common/story-meta.ts",
    "../component-contracts/ids/accordion.contract.ts",
    "../component-contracts/ids/alert.contract.ts",
    "../component-contracts/ids/button.contract.ts",
    "../component-contracts/ids/badge.contract.ts",
    "../component-contracts/ids/checkbox.contract.ts",
    "../component-contracts/ids/radio-button.contract.ts",
    "../component-contracts/ids/tab.contract.ts",
    "../component-contracts/ids/text-box.contract.ts",
    "../component-contracts/ids/modal.contract.ts",
    "../component-contracts/ids/masthead.contract.ts",
    "../component-contracts/ids/main-menu-left.contract.ts",
    "../component-contracts/ids/footer.contract.ts",
    "../component-contracts/ids/tag.contract.ts",
    "../component-contracts/ids/tooltip.contract.ts",
    "../component-contracts/ids/segmented-button.contract.ts",
    "../component-contracts/ids/datagrid.contract.ts",
    "../component-contracts/ids/pagination.contract.ts",
    "../component-contracts/ids/detail-panel.contract.ts",
    "../component-contracts/ids/anchor-menu.contract.ts",
    "../lib/angular/ids/**/*.ts",
    "../component-contracts/synapse/detail-panel.contract.ts"
  ]
}
