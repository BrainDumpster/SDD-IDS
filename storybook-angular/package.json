{
  "name": "ids-storybook-angular",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile:components": "ngc -p tsconfig.compile.json && node scripts/rewrite-compiled-contract-imports.js",
    "predev": "npm run compile:components",
    "prebuild": "npm run compile:components",
    "dev": "fuser -k 6007/tcp 2>/dev/null || true; npx ng run storybook-angular:storybook",
    "dev:clean": "fuser -k 6007/tcp 2>/dev/null || true; npm run compile:components && rm -rf node_modules/.cache/storybook && npx ng run storybook-angular:storybook",
    "build": "npx ng run storybook-angular:build-storybook",
    "storybook": "npx ng run storybook-angular:storybook"
  },
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-browser-dynamic": "^21.2.17",
    "rxjs": "^7.8.2",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.17",
    "@angular/cli": "^21.2.17",
    "@angular/compiler-cli": "^21.2.17",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/angular": "^10.4.6",
    "storybook": "^10.4.6",
    "ts-loader": "^9.6.2",
    "typescript": "^5.8.3"
  }
}
