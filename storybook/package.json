{
  "name": "synapse-storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "fuser -k 6006/tcp 2>/dev/null || true; rm -rf node_modules/.cache/storybook && storybook dev -p 6006 --ci",
    "dev:clean": "fuser -k 6006/tcp 2>/dev/null || true; rm -rf node_modules/.cache/storybook && storybook dev -p 6006 --ci",
    "dev:reset": "fuser -k 6006/tcp 2>/dev/null || true; npm run dev",
    "build": "storybook build",
    "storybook": "storybook dev -p 6006 --ci"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@base-ui-components/utils": "0.2.2",
    "gojs": "^3.1.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "storybook": "8.6.18",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}