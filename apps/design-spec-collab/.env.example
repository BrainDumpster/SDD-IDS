# Design Spec Collab — dual-agent POC
#
# cp .env.example .env

AUTH_MODE=disabled
PUBLIC_BASE_URL=http://127.0.0.1:8091

# stub | mcp | rest — rest recommended for server/PAT packaging (MCP-parity enrichment).
# live is accepted as rest. Official Figma MCP needs OAuth (IDE), not headless PAT.
FIGMA_MODE=rest
# FIGMA_TOKEN=
FIGMA_MCP_URL=https://api.figma.com/mcp

# Server review must stay light — default is deterministic rules (no LLM).
# Optional soft check only (never authors the spec):
#   SERVER_REVIEW_MODE=ollama
#   OLLAMA_HOST=http://host.docker.internal:11434   # from Docker on Linux use host IP
#   OLLAMA_MODEL=llama3
SERVER_REVIEW_MODE=rules
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3

COLLAB_MAX_TURNS=3
CLIENT_POLL_HINT_MS=2000
SESSION_TTL_HOURS=24
SESSION_REQUIRE_CLAIM=true
STUB_FORCE_REVISE_ONCE=true

# After accept: server opens PR via GitHub REST (no LLM) + zip download
AUTO_CREATE_PR=true
# true = fake PR URL + no GitHub write (local demo)
GITHUB_PUBLISH_DRY_RUN=true
GITHUB_TOKEN=
# Prefer full URL (also accepts CLOUD_REPO_URL)
GITHUB_REPO_URL=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_STARTING_REF=master

# Catalogue for dashboard (auto = local components/ when present)
CATALOGUE_SOURCE=auto

# Docker Compose host port mapping (optional)
# COLLAB_HOST_PORT=8091

# Deploy image tag (tar load or registry)
# COLLAB_IMAGE=design-spec-collab:1.0
# COLLAB_PULL_POLICY=never
