# Design Spec Collab — dual-agent POC
#
# cp .env.example .env

AUTH_MODE=disabled
# Local Docker: http://127.0.0.1:8091 is fine — the UI rewrites Bridge/session
# URLs to whatever host you open in the browser.
#
# Remote behind IDE/Jupyter proxy (hash route is NOT part of the base):
#   Browser:  http://10.0.0.1:8080/proxy/3/#/generate
#   Set:      PUBLIC_BASE_URL=http://10.0.0.1:8080/proxy/3
PUBLIC_BASE_URL=http://127.0.0.1:8091

# stub | mcp | rest — rest recommended for server/PAT packaging (MCP-parity enrichment).
# live is accepted as rest. Official Figma MCP needs OAuth (IDE), not headless PAT.
FIGMA_MODE=rest
# FIGMA_TOKEN=
FIGMA_MCP_URL=https://api.figma.com/mcp

# Server review must stay light — default is deterministic rules (no LLM).
# Optional soft check only (never authors the spec):
#   SERVER_REVIEW_MODE=ollama
#   OLLAMA_HOST=http://host.docker.internal:11434   # from Docker on Linux use host IP
#   OLLAMA_MODEL=llama3
SERVER_REVIEW_MODE=rules
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3

# Prefer 5–6 for real Devin/Bridge; keep 3 only for stub smoke tests
COLLAB_MAX_TURNS=6
CLIENT_POLL_HINT_MS=2000
SESSION_TTL_HOURS=24
SESSION_REQUIRE_CLAIM=true
# Operator UI idle timeout (minutes) after a job finishes — Continue or End (B2).
COLLAB_OPERATOR_IDLE_MINUTES=10
# true forces a revise on turn 1 (stub demos). Use false for Devin.
STUB_FORCE_REVISE_ONCE=false

# After accept: server opens PR via GitHub REST (no LLM) + zip download
AUTO_CREATE_PR=true
# true = fake PR URL + no GitHub write (local demo)
GITHUB_PUBLISH_DRY_RUN=true
GITHUB_TOKEN=
# Prefer full URL (also accepts CLOUD_REPO_URL)
GITHUB_REPO_URL=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_STARTING_REF=master

# Catalogue for dashboard (auto = local components/ when present)
CATALOGUE_SOURCE=auto

# Spec Accurate Design iframe preview (static Storybook under /storybook/)
# Docker image bakes this at /app/storybook-static (compose sets STORYBOOK_STATIC_DIR).
# On a remote server: leave unset or set STORYBOOK_STATIC_DIR=/app/storybook-static
# — never point this at a laptop/host path that does not exist in the container.
# After accept, Collab rebuilds static in-container when Node is present:
# STORYBOOK_REBUILD_ENABLED=true
# Local uvicorn: ./apps/design-spec-collab/scripts/build_collab_storybook_static.sh
# STORYBOOK_STATIC_DIR=/path/to/apps/design-spec-collab/storybook-static

# Docker Compose host port mapping (optional)
# COLLAB_HOST_PORT=8091

# Corporate SSL inspection (self-signed CA in chain) — see README § Corporate SSL
# Preferred: mount CA under ./certs/ then:
# REQUESTS_CA_BUNDLE=/certs/ca-bundle.pem
# SSL_CERT_FILE=/certs/ca-bundle.pem
# CURL_CA_BUNDLE=/certs/ca-bundle.pem
# Optional: COLLAB_CERTS_DIR=/etc/ssl/certs
# Escape hatch (insecure): disable TLS verify for Figma REST (+ GitHub publish inherits)
# FIGMA_SSL_VERIFY=false
# Optional override for GitHub only:
# GITHUB_SSL_VERIFY=false

# Deploy image tag (tar load or registry)
# COLLAB_IMAGE=design-spec-collab:1.0
# COLLAB_PULL_POLICY=never
