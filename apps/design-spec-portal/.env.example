# Repo root = monorepo containing config/design_systems and .cursor/skills
REPO_ROOT=

# Optional override (defaults to $REPO_ROOT/config/design_systems)
DESIGN_SYSTEMS_DIR=

# Phase 2 — job + session persistence
JOBS_DIR=
SESSIONS_DIR=
AUDIT_LOG_PATH=

# Auth placeholder (SSO TBD with stakeholders)
# disabled | placeholder | enforced
AUTH_MODE=disabled

# Phase 3 — Cursor Cloud agent
CURSOR_API_KEY=
FIGMA_TOKEN=
GITHUB_TOKEN=
CLOUD_REPO_URL=
# Optional allowlist (defaults to CLOUD_REPO_URL when set)
ALLOWED_CLOUD_REPO_URLS=
CLOUD_STARTING_REF=master
CURSOR_MODEL=composer-2.5
FIGMA_MCP_URL=https://api.figma.com/mcp
CLOUD_AGENT_AUTO_START=true
CLOUD_AGENT_DRY_RUN=true
# Phase 4 — ask Cursor Cloud to open a PR (dry-run: sample PR URL in UI)
CLOUD_AUTO_CREATE_PR=true

# Phase 4 — GitHub zip / PR fallback (required for real branch file fetch)
# GITHUB_TOKEN=   # also set above if you prefer a single token block
GITHUB_OWNER=
GITHUB_REPO=
