# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
design-system-knowledge
**/node_modules/
node_modules/
**/storybook/node_modules/
**/storybook-angular/node_modules/
storybook/storybook-static/
storybook-angular/storybook-static/
apps/design-spec-collab/storybook-static/
apps/design-spec-collab/storybook-static.building/
apps/design-spec-collab/backend/**/storybook-static/
storybook-angular/compiled/
storybook-angular/.angular/cache/
.angular/
**/.angular/
.cache/
**/.cache/

# Figma MCP token dumps (assembled into compact-export, then ids-theme.css)
storage/figma-exports/

# Temporary workspace artifacts
.tmp_*
**/.tmp_*
# Design-spec intake wizard session logs (optional audit files)
data/design-spec-intake/sessions/*
!data/design-spec-intake/sessions/.gitkeep

# Design-spec collab / portal runtime data (jobs, sessions, PR Storybook caches)
apps/design-spec-collab/data/review_sessions/
apps/design-spec-collab/data/jobs/
apps/design-spec-collab/data/sessions/
apps/design-spec-collab/data/collab_sessions/
apps/design-spec-collab/data/storybook_pr_builds/
apps/design-spec-portal/data/jobs/
apps/design-spec-portal/*.json

# Design-system bundle build output (regenerate via .ds-sync/package-build.mjs)
ds-bundle/
ds-bundle-synapse/
.ds-sync/

# /design-sync working state. The durable set (config.json, NOTES.md, previews/)
# IS committed - it is the carry-forward that makes re-syncs incremental.
.design-sync/*.log
.design-sync/sb-reference/
.design-sync/sb-reference-synapse/
.design-sync/learnings/
.design-sync/.cache/
.design-sync/node_modules
.design-sync/types/
.design-sync/*-theme-bundle.css
